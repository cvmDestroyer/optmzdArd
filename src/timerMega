namespace timerMega {
/*
  now that that we have everything we need we can start with our super precise millis() 
*/
// our init func sso we can activate the timer in ctc
void init(void)
{
    uint8_t oldSREG{SREG}; // the classic thing we need to do when working with atomic stuff
    cli(); // clear interrupt flags

    TCCR5A = 0; // clear tccr
    TCCR5B = 0; // clear tccr
    // now that everything is clean we can start flipping the right bits
    // the first thing we need is the ctc mode we only have to flip the bit WGM52 on tccrxb for ctc
    TCCR5B |= (1 << WGM52);
    // next up is the CSxx (clock select) we need a prescaler of 64 therfore we need the bits CSx1 and CSx0 (tccrxb)
    TCCR5B |= (1 << CS51) | (1 << CS50);
    // alright now every thing is set and we have to calculate till when the timer 5 should count in ctc mode
    // first we need to take the current clock speed which is 250.000 because of your prescaler of 64 and 
    // 16.000.000 (clock speed of arduino) / 64 (our prescaler) is 250.000
    // to figure out our limit we just take those 250k and devide it by 1k because thats how many ms one s has
    // and clock speed is in s so 250k clocks per second
    // therefore we can calulate the amount of clocks for ONE ms like this: 250.000 / 1000 = 250
    // now we know that 250 clocks are one ms and therefore we just set ctcs linit to 250
    // and because computers start counting at 0 we dont set the limiz zo 250 but to 249
    OCR5A = 249;
    // now we have to activate the ocr with the fitting bitz in TIMSK5 (in this case OCIE5A beause we used OCR5A)
    TIMSK5 |= (1 << OCIE5A);
    SREG = oldSREG;
}
// now we need a quick var to count the amount of times the interrupt was fired
volatile uint32_t ctc_limit_hits{};

uint32_t millis(void) {
    return ctc_limit_hits;
}
// now we just need to set up an interrupt service routine with ISR() {}
// in the brackets we need to give in a vector you can look up which vector to
// use in the tabel above
ISR(TIMER5_COMPA_vect) {
    ctc_limit_hits++; // now we just add one for every interrupt enter and thats it
}

