namespace interruptsMega {
#include "portsMega"
using namespace portsMega;

void (*volatile user_saved_func)(void);

void attachInterrupt(uint8_t pin, void(*user_func)(void), uint8_t mode) {
    // alright this works for every pin the almost the exact way therefore we only do one example for
    // PCINT and one for INT the rest you can try your self and correct it by comparing it with
    // the optmzdArd.cpp version in namespace gpio::mega

    // first we do the INT thingy for pin 21
    if (pin == 21) {
        EICRA &= ~((1 << ISC00) | (1 << ISC00)); // we deactivate the mode so we can chnage it based on the mode
        // the user selects and btw 21 is INT0 just so you know thats why ISC0x. pin 20 is INT1, pin 19 is INT2
        // , pin 18 is INT3, pin 2 is INT4 and pin 3 is INT5
        if (mode == FALLING) { // this is the thing i talked about earlier and why bit ISC00 and ISC01 had to be reset
            EICRA |= (1 << ISC01); // this is simply FALLING on the actual hardware interrupt and for the rest is the same
        } else if (mode == RISING) {
            EICRA |= (1 << ISC01) | (1 << ISC00);
        } else if (mode == CHANGE) {
            EICRA |= (1 << ISC00); 
        }
        user_saved_func = user_func; // just save the user_func
        // the next step is just to turn it on with EIMSK now we just need a vector and for INT0 the vector is called INT0_vect
        EIMSK |= (1 << INT0);
    }
    // now we need one more example for the PCINT and we just gonna use the worst version so if you wanna finish the 
    // the code it'll be quick and easy with no struggles
    if ((pin >= 10 && pin <= 13) || (pin >= 50 && pin <= 53)) {
        // alright on PCINT we first need to turn on PCINT in this case PCINT0 heres how:
        PCICR |= (1 << PCIE0); // thats all if you wanna turn any other PCINT just replace the 0 with the number of the PCINT
        uint8_t bit = (pin >= 50 && pin <= 53) ? (53 - pin) : (pin - 6);
    }
} 
