/*
  alright the ATmega2560 is chip with very many pins as you might have noticed already but the main
  idea of the ARmega380P can be used here almost 1 to 1 so if you DIDNT read analogUno that first
  IMPORTANT : if you want to code a analogRefrence function just keep in mind that there is one more 
  'mode' compared to uno here is the tabel for everything you need to know for analogReference:
    mode         REFS1    REFS0   binarybitmask(ADMUX)   Spannung
    EXTERNAL       0        0          0b00000000        AREF-pin
    DEFAULT        0        1          0b01000000        VCC (5V)
    INTERNAL1V1    1        0          0b10000000        internal 1,1 V
    INTERNAL2V56   1        1          0b11000000        internal 2,56 V

  alright thats enough for now let get straight into coding analogRead i will explain
  things we have to change compared to unos analogRead but dont worry its mostly the same
*/
namespace analogMega {

uint8_t analogRead(uint8_t pin)
{
    uint8_t channel {pin - 54}; // megas analog pins start at 54 so just subtract that so we get the 
                                // channel (we have to edit it later but its nicer to write
                                // channel - 8 instead of channel - 62 cuz nobody will get why -62)

    if (channel > 15) {return 0;} // if its not an analog pin just return

    uint8_t oldSREG = SREG;
    cli();

    // this is new now as may have oticed the 16 pins dont fit in a byte therfore
    // we cant just use ONE DIDR and the mega has for this very reason DIDR2 here you can
    // deactivate the other 8bits / pins (DIDR1 is also a thing but is used by the comperator)
    if (channel >= 8) {
        ADCSRB |= (1 << MUX5); // this seems very unassary but if you look closly you notice that MUX5
                               // IS NOT in ADMUX therefore syou need to do this weird thing
        ADMUX = 0b01000000 | ((channel - 8) & 0x07); // because MUX 5 is in binary '8' we have to remove the '8' in channel
                                                     // thats why we do a -8 and 0x07 is just a extra safty masurement but
                                                     // is technicly not nassary
        DIDR2 |= (1 << (channel - 8)); // pertty self explainatory we need to do -8 because now its a new byte which start at 0 NOT 8
    } else {
        ADCSRB &= ~(1 << MUX5);
        ADMUX = 0b01000000 | (channel & 0x07);
        DIDR0 |= (1 << channel);
    }

    // the rest is pretty much the same as the uno versions evern the same registers
    ADCSRA = (1 << ADEN) | (1 << ADPS2) | (1 << ADPS1) | (1 << ADPS0);

    ADCSRA |= (1 << ADSC);
    SREG = oldSREG;
    while (ADCSRA & (1 << ADSC))
        ;

    if (channel >= 8) { // this is the only diffrence just like before we need to disable
        DIDR2 &= ~(1 << (channel - 8)); // DIDR for both registers
    } else {
        DIDR0 &= ~(1 << channel);
    }

    return ADC;
}

