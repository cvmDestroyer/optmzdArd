void analogWrite(uint8_t pin, uint8_t val)
{
    if (pin >= 70) {return;}

    bool has_pwm{pgm_read_byte(&pin_table[pin].has_pwm)};
    
    if (!has_pwm) {
        digitalWrite(pin, (val <= 128) ? false : true);
        return;
    }

    volatile uint8_t* tccra {reinterpret_cast<volatile uint8_t*>(pgm_read_byte(&pin_table[pin].tccra))};
    volatile uint8_t* tccrb {reinterpret_cast<volatile uint8_t*>(pgm_read_byte(&pin_table[pin].tccrb))};
    volatile uint16_t* ocr  {reinterpret_cast<volatile uint16_t*>(pgm_read_word(&pin_table[pin].ocr))};
    uint8_t com_bit         {pgm_read_byte(&pin_table[pin].com_bit)};
    uint8_t tccra_bits      {pgm_read_byte(&pin_table[pin].tccra_bits)};
    uint8_t tccrb_bits      {pgm_read_byte(&pin_table[pin].tccrb_bits)};

    uint8_t oldSREG{SREG};
    cli();

    if (val == 0) {
        *tccra &= ~com_bit;
        digitalWrite(pin, LOW);
    } else if (val == 255) {
        *tccra &= ~com_bit;
        digitalWrite(pin, HIGH);
    } else {
        *tccra |= com_bit | tccra_bits;
        *tccrb = tccrb_bits;
        *ocr = val;
    }

    SREG = oldSREG;
}
