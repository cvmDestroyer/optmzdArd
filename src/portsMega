  BUT there is a other way and looks pretty simular to the original Arduino Core functions. the main idea is
  basicly the 'same' as in the templetes variants. first we make a large struct with all needed regs/bits and
  make a array of these structs the index is the pin so index 3 is pin 3. but if we would do that in memory
  the arduino would be almost at it limit (not realy but still its valuble memory) and that would be bad
  thats why we store it in 'flash'. you can interpret it as an storage thingy for your arduino (technicly your desktop
  has a flash too in the uefi/bios chip for example but in x86 cpp we dont do anything with it) it doesnt wipe
  everything if you deplug your arduino (thats hoiw the EEPROM lib works) Arduino Core gives us the 'keyword''PROGMEM'
  cuz thats how these are called with which we can do the saving thing into flash
  
  here is how we would do it:
*/
namespace portsMega { 

struct PinMap { // our stuct with all the data we need
    volatile uint8_t* port;    // this is a register therefore we need to 'share' it with '&' and use it with a pointer ('*')
    volatile uint8_t* ddr;     // this is a register therefore we need to 'share' it with '&' and use it with a pointer ('*')
    volatile uint8_t* pin_reg; // this is a register therefore we need to 'share' it with '&' and use it with a pointer ('*')
    uint8_t mask;              // this are just bits so we can just save it.

    bool has_pwm;            // semi nassary for digitalWrite ('turnOffPwm')
    volatile uint8_t* tccra; // (not nassary for digital... but for analog) 
    volatile uint8_t* tccrb; // (not nassary for digital... but for analog) 
    volatile uint16_t* ocr;  // (not nassary for digital... but for analog) 
    uint8_t com_bit;         // (not nassary for digital... but for analog) 
    uint8_t tccra_bits;      // (not nassary for digital... but for analog) 
    uint8_t tccrb_bits;      // (not nassary for digital... but for analog) 
};

